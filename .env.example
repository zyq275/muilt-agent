# ============================================================
# 探渊 — 环境变量模板（TDD §12）
# ============================================================
#
# 用法：复制为 .env 后填入真实值。
#   cp .env.example .env
#
# .env 已在 .gitignore 中，**绝不可提交**。
# 本文件（.env.example）不含任何真实密钥，应当提交，用于说明需要哪些配置。
#
# 代码中一律通过 os.getenv() 读取，不允许出现硬编码密钥（TDD §14）。

# ── 大模型（DeepSeek，OpenAI 兼容协议）────────────────────
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── RAGAS 评估裁判模型（阶段 9，可选）─────────────────────
#
# 留空则回退到 DEEPSEEK_MODEL。建议配成与生成模型不同的一个：
# 同一个模型既生成答案、又给自己打分，会系统性偏乐观。
# 走同一个 BASE_URL / API_KEY，无需额外密钥。
RAGAS_JUDGE_MODEL=deepseek-v4-pro

# ── 联网搜索（Tavily）─────────────────────────────────────
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 向量检索（本地 embedding，无需密钥）───────────────────
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL_PATH=./model/bge-small-zh-v1.5
KNOWLEDGE_BASE_DIR=./knowledge_base
VECTOR_STORE_DIR=./vector_store

# ── MySQL ────────────────────────────────────────────────
#
# 【重要】MYSQL_USER 必须指向**只读账号**，不要填 root。
#
# 应用层的关键字拦截（tools/mysql_tools.py）只是兜底，可以被绕过；
# 数据库权限才是不可绕过的防线。建账号见 sql/create_readonly_user.sql：
#
#     CREATE USER 'tanyuan_ro'@'localhost' IDENTIFIED BY '<强密码>';
#     GRANT SELECT ON pharma_db.* TO 'tanyuan_ro'@'localhost';
#
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=tanyuan_ro
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_DATABASE=pharma_db
MYSQL_CHARSET=utf8mb4
